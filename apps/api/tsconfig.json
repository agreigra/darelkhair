{
  "extends": "../../packages/config/typescript/nestjs.json",
  "compilerOptions": {
    "outDir": "./dist",
    // baseUrl is required for tsc-alias to rewrite @/ imports in the emitted JS.
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["src/**/*", "prisma/**/*", "prisma.config.ts"]
}