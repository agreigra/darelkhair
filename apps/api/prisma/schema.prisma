// DarElKhair — Prisma baseline schema.
// All core models are defined here so every later feature drops in cleanly.
// Feature steps will extend these models (relations, indexes) as needed.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Prisma 7: the connection URL lives in prisma.config.ts (for CLI/migrate) and
  // is passed to PrismaClient via the pg driver adapter (see PrismaService).
}

// ──────────────────────────────────────────────────────────────
// Enums
// ──────────────────────────────────────────────────────────────

enum UserRole {
  USER
  ADMIN
}

enum BookingStatus {
  PENDING
  WAITING_PAYMENT
  PROOF_SUBMITTED
  CONFIRMED
  CANCELLED
}

enum PaymentMethod {
  BANK_TRANSFER
  MOBILE_MONEY
  CASH
}

enum PaymentStatus {
  PENDING
  SUBMITTED
  VERIFIED
  REJECTED
}

enum NotificationType {
  BOOKING_CREATED
  BOOKING_STATUS_CHANGED
  PAYMENT_SUBMITTED
  PAYMENT_VERIFIED
  PAYMENT_REJECTED
  SYSTEM
}

// ──────────────────────────────────────────────────────────────
// Identity & access
// ──────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  firstName    String?
  lastName     String?
  phone        String?
  role         UserRole @default(USER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens RefreshToken[]
  bookings      Booking[]
  notifications Notification[]
  auditLogs     AuditLog[]

  @@index([role])
  @@map("users")
}

// Refresh-token rotation (Feature 1 — Auth). One row per issued token; the
// hash is stored so a leaked DB row can't be replayed as a usable token.
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ──────────────────────────────────────────────────────────────
// Catalogue
// ──────────────────────────────────────────────────────────────

model Apartment {
  id           String   @id @default(cuid())
  // Localized text — JSON shaped { "fr": "…", "ar": "…", "en": "…" } (LocalizedText).
  // Admin fills all locales via tabbed forms; the public side renders the active locale.
  title        Json
  description  Json?
  address      Json?
  city         Json?
  pricePerNight Decimal @db.Decimal(10, 2)
  bedrooms     Int      @default(1)
  bathrooms    Int      @default(1)
  maxGuests    Int      @default(2)
  isPublished  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  images           ApartmentImage[]
  availabilitySlots AvailabilitySlot[]
  bookings         Booking[]

  @@index([isPublished])
  @@map("apartments")
}

model ApartmentImage {
  id          String   @id @default(cuid())
  apartmentId String
  url         String
  // Storage key (R2 object key or local path) — set for uploaded files so the
  // object can be removed from storage on delete. Null for externally-hosted URLs.
  storageKey  String?
  alt         String?
  isCover     Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  apartment Apartment @relation(fields: [apartmentId], references: [id], onDelete: Cascade)

  @@index([apartmentId])
  @@map("apartment_images")
}

// Availability is stored as discrete slots (a date range). Feature 4 fills in
// conflict-detection logic; bookings reference the slot they consume.
model AvailabilitySlot {
  id          String   @id @default(cuid())
  apartmentId String
  startDate   DateTime @db.Date
  endDate     DateTime @db.Date
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  apartment Apartment @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  bookings  Booking[]

  @@index([apartmentId])
  @@index([startDate, endDate])
  @@map("availability_slots")
}

// ──────────────────────────────────────────────────────────────
// Bookings & payments
// ──────────────────────────────────────────────────────────────

model Booking {
  id          String        @id @default(cuid())
  reference   String        @unique @default(cuid())
  userId      String
  apartmentId String
  slotId      String?
  checkIn     DateTime      @db.Date
  checkOut    DateTime      @db.Date
  guests      Int           @default(1)
  totalPrice  Decimal       @db.Decimal(10, 2)
  status      BookingStatus @default(PENDING)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  apartment Apartment         @relation(fields: [apartmentId], references: [id])
  slot      AvailabilitySlot? @relation(fields: [slotId], references: [id])
  payment   Payment?
  history   BookingStatusHistory[]

  @@index([userId])
  @@index([apartmentId])
  @@index([status])
  @@map("bookings")
}

// Append-only trail of every status transition (Feature 5).
model BookingStatusHistory {
  id        String        @id @default(cuid())
  bookingId String
  fromStatus BookingStatus?
  toStatus  BookingStatus
  changedBy String?
  note      String?
  createdAt DateTime      @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@map("booking_status_history")
}

model Payment {
  id           String        @id @default(cuid())
  bookingId    String        @unique
  method       PaymentMethod
  status       PaymentStatus @default(PENDING)
  amount       Decimal       @db.Decimal(10, 2)
  proofUrl     String?
  // Storage key (R2 object key or local path) for the uploaded proof image, so
  // the object can be removed from storage on re-submit/delete. Null for cash.
  proofKey     String?
  reference    String?
  verifiedById String?
  verifiedAt   DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("payments")
}

// ──────────────────────────────────────────────────────────────
// Cross-cutting
// ──────────────────────────────────────────────────────────────

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String?
  isRead    Boolean          @default(false)
  metadata  Json?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

// Security rule: audit logs on sensitive mutations across all features.
model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String?
  entityId  String?
  metadata  Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entity, entityId])
  @@map("audit_logs")
}
