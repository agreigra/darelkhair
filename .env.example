# ──────────────────────────────────────────────────────────────
# DarElKhair — environment template. Copy to .env and fill values.
# ──────────────────────────────────────────────────────────────

# ── Postgres (docker-compose service `postgres`) ──
POSTGRES_USER=darelkhair
POSTGRES_PASSWORD=darelkhair_dev_password
POSTGRES_DB=darelkhair
# Host port the docker Postgres is published on. If you already run a local
# Postgres on 5432 (e.g. Homebrew/Postgres.app), set this to 5433 and update the
# port in DATABASE_URL to match.
POSTGRES_PORT=5432

# ── Backend (NestJS API) ──
API_PORT=4000
NODE_ENV=development
# When running the API in Docker, host is `postgres`; locally it is `localhost`.
DATABASE_URL=postgresql://darelkhair:darelkhair_dev_password@localhost:5432/darelkhair?schema=public

# JWT (Feature 1 — Auth)
JWT_ACCESS_SECRET=change_me_access_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_REFRESH_EXPIRES_IN=7d

# CORS — comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:3000

# ── File storage / uploads ──
# 'local' = store on disk and serve from the API (dev default).
# 'r2'    = upload to Cloudflare R2 (requires the R2_* vars below).
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=5
# Absolute base URL of the API (used to build public URLs for local files).
API_PUBLIC_URL=http://localhost:4000

# Cloudflare R2 (only needed when STORAGE_DRIVER=r2)
# Account ID from the Cloudflare dashboard; the S3 endpoint is derived from it.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public base URL the bucket is served from — an R2.dev domain or a custom domain.
# e.g. https://pub-xxxxxxxx.r2.dev. The web build reads this to whitelist the host
# for the Next.js Image Optimizer (next.config.ts), so a custom domain needs no
# code change — just set it here. Passed to the web image as a build arg.
R2_PUBLIC_URL=

# ── Frontend (Next.js) ──
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000
# Public WhatsApp support number (Feature 6), international format, no +
NEXT_PUBLIC_WHATSAPP_NUMBER=22200000000
