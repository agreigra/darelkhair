# ──────────────────────────────────────────────────────────────
# DarElKhair — environment template. Copy to .env and fill values.
# ──────────────────────────────────────────────────────────────

# ── Postgres (docker-compose service `postgres`) ──
POSTGRES_USER=darelkhair
POSTGRES_PASSWORD=darelkhair_dev_password
POSTGRES_DB=darelkhair
# Host port the docker Postgres is published on. If you already run a local
# Postgres on 5432 (e.g. Homebrew/Postgres.app), set this to 5433 and update the
# port in DATABASE_URL to match.
POSTGRES_PORT=5432

# ── Backend (NestJS API) ──
API_PORT=4000
NODE_ENV=development
# When running the API in Docker, host is `postgres`; locally it is `localhost`.
DATABASE_URL=postgresql://darelkhair:darelkhair_dev_password@localhost:5432/darelkhair?schema=public

# JWT (Feature 1 — Auth)
JWT_ACCESS_SECRET=change_me_access_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_REFRESH_EXPIRES_IN=7d

# CORS — comma-separated origins allowed to call the API.
# In production set this to your web origin, e.g. https://your-app.vercel.app
CORS_ORIGINS=http://localhost:3000

# Refresh-cookie SameSite. Keep 'lax' locally. Set to 'none' when the web app and
# API are on different sites (e.g. *.vercel.app + *.railway.app) so the httpOnly
# refresh cookie is sent cross-site — otherwise login drops on the next request.
# 'none' requires HTTPS (Secure is added automatically).
COOKIE_SAMESITE=lax

# ── File storage / uploads ──
# 'local' = store on disk and serve from the API (dev default).
# 'r2'    = upload to Cloudflare R2 (requires the R2_* vars below).
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=5
# Absolute base URL of the API (used to build public URLs for local files).
API_PUBLIC_URL=http://localhost:4000

# Cloudflare R2 (only needed when STORAGE_DRIVER=r2)
# Account ID from the Cloudflare dashboard; the S3 endpoint is derived from it.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public base URL the bucket is served from — an R2.dev domain or a custom domain.
# e.g. https://pub-xxxxxxxx.r2.dev. The web build reads this to whitelist the host
# for the Next.js Image Optimizer (next.config.ts), so a custom domain needs no
# code change — just set it here. Passed to the web image as a build arg.
R2_PUBLIC_URL=

# ── Offline payment instructions (Feature 6) ──
# Shown to guests on the payment page. Placeholders below are dev defaults.
PAYMENT_BANK_NAME=DarElKhair Bank
PAYMENT_BANK_ACCOUNT_NAME=DarElKhair SARL
PAYMENT_BANK_ACCOUNT_NUMBER=000123456789
PAYMENT_BANK_IBAN=
PAYMENT_MOBILE_MONEY_NUMBER=22200000000
# International format, no '+'. Also used for the WhatsApp support link.
PAYMENT_WHATSAPP_NUMBER=22200000000

# ── Outbound email / password reset ──
# Public base URL of the web app — used to build links in emails (e.g. the
# password-reset link). No trailing slash.
WEB_APP_URL=http://localhost:3000
# SMTP credentials. Leave SMTP_HOST empty to run the mailer in "log mode": emails
# (and the reset link) are printed to the API console instead of being sent —
# handy for local dev with no mail server. Set these to send real email.
# Gmail example: host smtp.gmail.com, port 587, SECURE=false, PASS = an App
# Password (requires 2-Step Verification), and MAIL_FROM using the same address.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=DarElKhair <no-reply@darelkhair.xyz>

# ── Contact details (Feature 12) ──
# Shown publicly on the Contact page. Placeholders below are dev defaults.
CONTACT_ADDRESS=Immeuble DarElKhair, Nouakchott, Mauritanie
CONTACT_PHONE=+222 44 22 35 00
CONTACT_EMAIL=contact@darelkhair.xyz
# International format, no '+'. Falls back to PAYMENT_WHATSAPP_NUMBER when unset.
CONTACT_WHATSAPP_NUMBER=

# ── Frontend (Next.js) ──
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000
# Public WhatsApp support number (Feature 6), international format, no +
NEXT_PUBLIC_WHATSAPP_NUMBER=22200000000
